generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  lifetimeWinnings Float    @default(0.0)
  lifetimeLosses   Float    @default(0.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model GameRecord {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  players   Json     // JSON array of participants: [{ "userId": "...", "username": "...", "buyIn": 100, "finalChips": 150, "net": 50 }]
  roomCode  String?
  totalPot  Float?   @default(0.0)
  createdAt DateTime @default(now())

  @@map("game_records")
}
